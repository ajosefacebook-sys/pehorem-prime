generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  phone        String?
  avatar       String?
  password     String
  role         String    @default("user")
  isVerified   Boolean   @default(false)
  company      String?
  license      String?
  bio          String?
  rating       Float     @default(0)
  reviewCount  Int       @default(0)
  portfolio    String[]
  socialLinks  Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  properties   Property[]
  vehicles     Vehicle[]
  inquiries    Inquiry[]
  campaigns    AdCampaign[]
  reviews      Review[]
  savedListings SavedListing[]
  notifications Notification[]
  boosts       Boost[]   @relation("UserBoosts")
  boostApprovals Boost[] @relation("BoostApprovals")
}

model Property {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String
  price        Float
  currency     String   @default("USD")
  type         String
  status       String   @default("for-sale")
  bedrooms     Int?
  bathrooms    Int?
  area         Float
  areaUnit     String   @default("sqft")
  location     String
  city         String
  state        String
  country      String   @default("Nigeria")
  latitude     Float?
  longitude    Float?
  images       String[]
  video        String?
  virtualTour  String?
  features     String[]
  amenities    String[]
  yearBuilt    Int?
  isFeatured   Boolean  @default(false)
  isSponsored  Boolean  @default(false)
  isApproved   Boolean  @default(false)
  isPaused     Boolean  @default(false)
  agentId      String?
  agent        User?    @relation(fields: [agentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inquiries    Inquiry[] @relation("PropertyInquiries")
}

model Vehicle {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String
  price        Float
  currency     String   @default("USD")
  make         String
  model        String
  year         Int
  mileage      Int
  fuelType     String
  transmission String
  bodyType     String
  condition    String
  color        String
  engineSize   String?
  images       String[]
  video        String?
  features     String[]
  location     String
  isFeatured   Boolean  @default(false)
  isSponsored  Boolean  @default(false)
  isApproved   Boolean  @default(false)
  isPaused     Boolean  @default(false)
  dealerId     String?
  dealer       User?    @relation(fields: [dealerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inquiries    Inquiry[] @relation("VehicleInquiries")
}

model Boost {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation("UserBoosts", fields: [userId], references: [id])
  listingId       String
  listingType     String
  planName        String
  amount          Float
  paymentReference String?
  paymentStatus   String    @default("pending")
  approvalStatus  String    @default("pending")
  approvedBy      String?
  approvedByUser  User?     @relation("BoostApprovals", fields: [approvedBy], references: [id])
  approvedAt      DateTime?
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([listingId, listingType])
  @@index([approvalStatus])
  @@index([paymentStatus])
}

model Inquiry {
  id              String    @id @default(uuid())
  type            String
  referenceId     String
  name            String
  email           String
  phone           String?
  message         String
  isRead          Boolean   @default(false)
  status          String    @default("new")
  statusUpdatedAt DateTime?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  property        Property? @relation("PropertyInquiries", fields: [propertyId], references: [id])
  propertyId      String?
  vehicle         Vehicle?  @relation("VehicleInquiries", fields: [vehicleId], references: [id])
  vehicleId       String?
  createdAt       DateTime  @default(now())
}

model AdCampaign {
  id             String   @id @default(uuid())
  type           String
  referenceId    String
  budget         Float
  spent          Float    @default(0)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  leads          Int      @default(0)
  status         String   @default("active")
  startDate      DateTime @default(now())
  endDate        DateTime?
  targetAudience String?
  targetLocation String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SavedListing {
  id        String   @id @default(uuid())
  type      String
  listingId String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  content   String
  targetId  String
  targetType String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model SiteSettings {
  id        String   @id @default("default")
  siteName  String   @default("PEHOREM PRIME")
  tagline   String   @default("Luxury Properties & Premium Vehicles Marketplace")
  whatsapp  String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  socialLinks Json?
  heroSlides Json?
  stats     Json?
  updatedAt DateTime @updatedAt
}

model BlogCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id           String       @id @default(uuid())
  title        String
  slug         String       @unique
  excerpt      String?
  content      String
  coverImage   String?
  author       String       @default("Admin")
  published    Boolean      @default(false)
  featured     Boolean      @default(false)
  categoryId   String?
  category     BlogCategory? @relation(fields: [categoryId], references: [id])
  tags         String[]
  metaTitle    String?
  metaDesc     String?
  keywords     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SiteContent {
  id        String   @id @default("home")
  key       String   @unique
  title     String?
  subtitle  String?
  content   String?
  images    String[]
  metadata  Json?
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Media {
  id         String   @id @default(uuid())
  name       String
  url        String
  type       String
  size       Int?
  width      Int?
  height     Int?
  alt        String?
  folder     String   @default("general")
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String?
  entityId   String?
  adminId    String?
  adminName  String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommissionTier {
  STARTER
  SILVER
  GOLD
  PLATINUM
}

enum ReferralStatus {
  PENDING
  CONVERTED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

model Affiliate {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String
  firstName         String
  lastName          String
  phone             String
  businessName      String
  businessAddress   String
  companyRegNumber  String
  tin               String
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  promotionMethod   String
  referralCode      String           @unique
  status            AffiliateStatus  @default(PENDING)
  rejectionReason   String?
  commissionTier    CommissionTier   @default(STARTER)
  totalClicks       Int              @default(0)
  totalReferrals    Int              @default(0)
  totalEarnings     Float            @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  referrals         Referral[]
  payouts           Payout[]
}

model Referral {
  id               String         @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate      @relation(fields: [affiliateId], references: [id])
  referredEmail    String
  referredName     String?
  planName         String
  planValue        Float
  commissionRate   Float
  commissionEarned Float
  status           ReferralStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  convertedAt      DateTime?
}

model Payout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id])
  amount      Float
  status      PayoutStatus @default(PENDING)
  reference   String?
  note        String?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?
}

model AffiliateClick {
  id           String   @id @default(cuid())
  referralCode String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}
